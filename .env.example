# ═══════════════════════════════════════════
# Portfolio Environment Variables
# ═══════════════════════════════════════════

# Admin password for the editable status badge on the hero section.
# Choose a long, random string. Rotate by updating this value and redeploying.
ADMIN_PASSWORD=your_admin_password_here

# Secret used to sign the admin session cookie. If omitted, ADMIN_PASSWORD is
# used as the HMAC key — which means changing the password invalidates all
# existing sessions. Set this to a separate random string if you want session
# continuity across password rotations.
AUTH_SECRET=your_auth_secret_here

# ─── Status store (required in production) ───
# The editable hero status badge persists to Upstash Redis. Serverless/edge
# filesystems are read-only, so without these the Save action returns 500 in
# production. Create a free database at https://upstash.com and paste its REST
# credentials below. If omitted, the app falls back to a local file — fine for
# `next dev`, but writes will NOT persist once deployed.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here
